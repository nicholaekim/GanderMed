# Copy to .env.local and fill in, then restart the dev server.

# Enables the AI alert-explainer chat. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the chat model. Defaults to claude-opus-4-8.
# Set to claude-haiku-4-5 for a much cheaper/faster option.
CHAT_MODEL=

# Enables "Continue with Google" sign-in (free).
# console.cloud.google.com -> APIs & Services -> OAuth consent screen (External,
# add yourself as test user) -> Credentials -> Create OAuth client ID (Web application)
# with authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enables shortage checking against Health Canada's shortage database (free
# registration at drugshortagescanada.ca — the site now redirects to
# healthproductshortages.ca). Without these, medications honestly report
# "supply not checked" — never "no shortage".
DSC_EMAIL=
DSC_PASSWORD=
# Optional: override if the API moves with the site rebrand.
# Default: https://www.drugshortagescanada.ca/api/v1
DSC_API_BASE=
